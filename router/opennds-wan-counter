#!/bin/sh

# Persistent WAN byte counter for the openNDS manager.
# This only reads interface statistics; it does not configure networking.

set -u

IFACE="${1:-eth0}"
STATE_DIR="/etc/opennds-manager"
STATE_FILE="$STATE_DIR/wan-counter.state"
INTERVAL=30

umask 077
mkdir -p "$STATE_DIR"

boot_id=""
boot_started_at=0
last_rx=0
last_tx=0
total_rx=0
total_tx=0
updated_at=0

if [ -r "$STATE_FILE" ]; then
	# This file is generated by this root-owned service and contains only
	# numeric values plus the kernel boot id.
	. "$STATE_FILE"
fi

valid_number() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

for name in boot_started_at last_rx last_tx total_rx total_tx updated_at; do
	value=$(eval "printf '%s' \${$name}")
	valid_number "$value" || eval "$name=0"
done

read_counter() {
	local path="$1" value
	value=$(cat "$path" 2>/dev/null || true)
	if valid_number "$value"; then
		printf '%s' "$value"
	else
		printf '%s' ''
	fi
}

router_boot_id() {
	cat /proc/sys/kernel/random/boot_id 2>/dev/null || true
}

router_boot_started_at() {
	local now uptime
	now=$(date +%s)
	uptime=$(cut -d. -f1 /proc/uptime 2>/dev/null || true)
	if valid_number "$uptime"; then
		printf '%s' $((now - uptime))
	else
		printf '%s' "$now"
	fi
}

write_state() {
	local temporary="${STATE_FILE}.tmp.$$"
	{
		printf 'version=1\n'
		printf 'interface=%s\n' "$IFACE"
		printf 'boot_id=%s\n' "$boot_id"
		printf 'boot_started_at=%s\n' "$boot_started_at"
		printf 'last_rx=%s\n' "$last_rx"
		printf 'last_tx=%s\n' "$last_tx"
		printf 'total_rx=%s\n' "$total_rx"
		printf 'total_tx=%s\n' "$total_tx"
		printf 'updated_at=%s\n' "$updated_at"
	} > "$temporary" && mv -f "$temporary" "$STATE_FILE"
}

sample() {
	local rx tx current_boot now
	rx=$(read_counter "/sys/class/net/$IFACE/statistics/rx_bytes")
	tx=$(read_counter "/sys/class/net/$IFACE/statistics/tx_bytes")
	if ! valid_number "$rx" || ! valid_number "$tx"; then
		return 0
	fi

	current_boot=$(router_boot_id)
	now=$(date +%s)
	if [ -n "$current_boot" ] && [ "$current_boot" != "$boot_id" ]; then
		boot_id="$current_boot"
		boot_started_at=$(router_boot_started_at)
		last_rx="$rx"
		last_tx="$tx"
		updated_at="$now"
		write_state
		return 0
	fi

	if [ "$rx" -ge "$last_rx" ]; then
		total_rx=$((total_rx + rx - last_rx))
	fi
	if [ "$tx" -ge "$last_tx" ]; then
		total_tx=$((total_tx + tx - last_tx))
	fi
	last_rx="$rx"
	last_tx="$tx"
	updated_at="$now"
	write_state
}

current_boot=$(router_boot_id)
rx=$(read_counter "/sys/class/net/$IFACE/statistics/rx_bytes")
tx=$(read_counter "/sys/class/net/$IFACE/statistics/tx_bytes")
if valid_number "$rx" && valid_number "$tx"; then
	if [ -n "$current_boot" ] && [ "$current_boot" != "$boot_id" ]; then
		boot_id="$current_boot"
		boot_started_at=$(router_boot_started_at)
	fi
	last_rx="$rx"
	last_tx="$tx"
	updated_at=$(date +%s)
	write_state
fi

stop_counter() {
	sample
	exit 0
}
trap stop_counter TERM INT

while :; do
	sleep "$INTERVAL"
	sample
done
