#!/bin/sh /etc/rc.common
START=96
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/lib/opennds/opennds-extra-interface.sh
    procd_set_param respawn 30 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

# Keep the guard and existing rules on stop: stopping this helper must not
# silently open selected LANs or disturb primary LAN sessions.
